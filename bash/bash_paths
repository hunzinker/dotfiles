export EDITOR=vim

HOMEBREW=$(brew --prefix)

BIN=$HOME/bin
LOCAL_BIN=$HOME/.local/bin
COREUTILS=$HOMEBREW/opt/coreutils/libexec/gnubin

export RBENV_ROOT=$(brew --prefix)/var/rbenv
export BROWSER=$HOME/bin/vim-browser
export RUST=$HOME/.cargo/bin

source $HOME/.dotfiles/ignored/bash_paths

export PATH=$HOMEBREW/bin:$HOMEBREW/sbin:$COREUTILS:$PATH:$BIN:$RUST:$LOCAL_BIN

MAN_GNUSED=$HOMEBREW/opt/gnu-sed/libexec/gnuman
MAN_COREUTILS=$HOMEBREW/opt/coreutils/libexec/gnuman

export MANPATH=$MAN_COREUTILS:$MAN_GNUSED:$MANPATH
