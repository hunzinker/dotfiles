[user]
    name = %NAME%
    email = %EMAIL%
[core]
    editor = vim
    autocrlf = input
[push]
    default = current
[color]
    ui = auto
[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold
    whitespace = red reverse
[color "status"]
    added = yellow
    changed = green
    untracked = cyan
[alias]
    los = log --color --graph --decorate --oneline
    lol = log --color --graph --decorate
    lols = log --color --graph --decorate --stat
    st = status
    br = branch
    co = checkout
    cp = cherry-pick
    copr = "!f() { git fetch -fu ${2:-origin} refs/pull/$1/head:pr-$1; \
      git co pr-$1; } ; f"
    prunepr = "!git for-each-ref refs/heads/pr-* --format='%(refname:short)' \
      | while read ref ; do git branch -D $ref ; done"
    wt = "!f() { \
      root=$(git worktree list --porcelain | sed -n '1s/^worktree //p')/.worktrees; \
      cmd=$1; \
      shift; \
      case \"$cmd\" in \
          add|a) \
              name=$1; \
              branch=${2:-$1}; \
              if [ -z \"$name\" ]; then echo \"❌ Usage: git wt add <name> [branch]\"; return 1; fi; \
              if git show-ref --verify --quiet \"refs/heads/$branch\"; then \
                  git worktree add \"$root/$name\" \"$branch\"; \
              else \
                  git worktree add \"$root/$name\" -b \"$branch\"; \
              fi || return 1; \
              if [ -f \"$root/$name/pyproject.toml\" ]; then (cd \"$root/$name\" && uv sync); fi; \
              echo \"👉 To jump in: cd $root/$name\"; \
              ;; \
          rm|d) \
              name=$1; \
              if [ -z \"$name\" ]; then echo \"❌ Usage: git wt rm <name>\"; return 1; fi; \
              git worktree remove \"$root/$name\"; \
              ;; \
          go|g) \
              name=$1; \
              if [ -z \"$name\" ] || [ ! -d \"$root/$name\" ]; then \
                  echo \"❌ Active worktrees:\"; \
                  ls -1 \"$root\" 2>/dev/null || echo \"  (None)\"; \
                  return 1; \
                  fi; \
              echo \"cd $root/$name\"; \
              ;; \
          ls) \
              git worktree list; \
              ;; \
          *) \
              echo \"🌿 Git Worktree Helper\"; \
              echo \"git wt add <name> [branch]  - Create worktree\"; \
              echo \"git wt rm <name>            - Remove worktree\"; \
              echo \"git wt go <name>            - Show cd command\"; \
              echo \"git wt ls                   - List all\"; \
              ;; \
      esac; \
    }; f"
[pull]
    rebase = true
[rerere]
    enabled = true
[rebase]
    autosquash = true
